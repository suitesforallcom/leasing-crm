          },
          {
            "name": "minAmountUsd",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000000,
              "description": "Показывать только лизы с суммарным долгом не меньше этой суммы (USD)."
